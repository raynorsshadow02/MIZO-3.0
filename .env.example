# ===================================================
# MIZO 3.0 CLOUD SERVER CONFIGURATION
# ===================================================

# Application
APP_NAME="Mizo 3.0 Cloud Server"
HOST="0.0.0.0"
PORT=8000
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Default AI Provider: "groq" | "openai" | "qwen" | "ollama"
DEFAULT_AI_PROVIDER="groq"

# API Keys (Can also be configured dynamically from Admin Dashboard)
GROQ_API_KEY=""
OPENAI_API_KEY=""
QWEN_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Models
GROQ_MODEL="llama-3.3-70b-versatile"
OPENAI_MODEL="gpt-4o-mini"
QWEN_MODEL="qwen/qwen-2.5-72b-instruct"
GROQ_WHISPER_MODEL="whisper-large-v3"

# TTS Configuration (Edge-TTS Neural Voices)
# Options: "en-US-GuyNeural", "en-US-JennyNeural", "en-IN-PrabhatNeural", "en-GB-SoniaNeural"
DEFAULT_TTS_VOICE="en-US-GuyNeural"
DEFAULT_TTS_RATE="+0%"
DEFAULT_TTS_PITCH="+0Hz"

# ESP32 Security
DEFAULT_DEVICE_KEY="mizo_esp32_secret_key_123"

# Storage
DATA_DIR="data"
UPLOAD_DIR="data/uploads"
AUDIO_CACHE_DIR="data/audio_cache"
DATABASE_PATH="data/mizo.db"
